---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Story from '../components/Story.astro';
import RoleEntry from '../components/RoleEntry.astro';
import { contact, areas, research, industry, leadership, featured, earlier, skills, education } from '../data/site';
import type { Area, Role } from '../data/site';

const nav = [
  { href: '#work', label: 'Work' },
  { href: '#experience', label: 'Experience' },
  { href: '#projects', label: 'Projects' },
  { href: '#about', label: 'About' },
  { href: '#contact', label: 'Contact' },
];
const areaShort = Object.fromEntries(areas.map((a) => [a.id, a.short])) as Record<Area, string>;
const anchors: Record<string, string> = {
  'RoboCup @ Prediction and Action Lab': 'robocup',
  FulfillmentIQ: 'fulfillmentiq',
  'Aarisha Consultancy': 'aarisha',
  QueueUp: 'queueup',
  'Altum Labs': 'altum',
  'Doctor Rounds': 'doctor-rounds',
  'Aartham Hospitals': 'aartham',
  'ASL recognition': 'asl',
  'Werling Lab': 'werling',
  'Fraud detection': 'fraud',
};
const groups: { id: string; name: string; roles: Role[] }[] = [
  { id: 'research', name: 'Research', roles: research },
  { id: 'industry', name: 'Industry', roles: industry },
];
const year = new Date().getFullYear();
---

<Base
  title="Het Parekh | Software Engineer"
  description="Het Parekh is a software engineer and CS + Data Science student at UW–Madison (Dec 2026), working on robot perception, backend systems, applied ML, and data science research."
>
  <a class="skip" href="#main">Skip to content</a>

  <header class="topbar">
    <div class="topbar__inner wrap">
      <a class="brand" href="#top"><span class="brand__mark" aria-hidden="true"></span>Het Parekh</a>
      <nav class="topnav" aria-label="Sections">
        <ul>
          {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
        </ul>
      </nav>
      <div class="topbar__actions">
        <button class="icon-btn" type="button" data-theme-toggle aria-label="Dark mode" aria-pressed="false">
          <span class="when-light"><Icon name="moon" size={18} /></span>
          <span class="when-dark"><Icon name="sun" size={18} /></span>
        </button>
        <a class="btn btn--ink btn--sm topbar__cta" href={`mailto:${contact.email}`}>Say hi</a>
        <button class="icon-btn topbar__menu" type="button" popovertarget="menu" aria-label="Open menu">
          <Icon name="menu" size={18} />
        </button>
      </div>
    </div>
    <div id="menu" class="sheet" popover>
      <button class="icon-btn sheet__close" type="button" popovertarget="menu" popovertargetaction="hide" aria-label="Close menu">
        <Icon name="close" size={18} />
      </button>
      <ul>
        {nav.map((n) => <li><a href={n.href} data-close-menu>{n.label}</a></li>)}
      </ul>
    </div>
  </header>

  <main id="main">
    <!-- Hero -->
    <section class="hero wrap" id="top" aria-labelledby="hello">
      <div class="hero__copy">
        <h1 id="hello">
          Hi, I'm <span class="hello-name">Het.<svg class="scribble" viewBox="0 0 200 24" preserveAspectRatio="none" aria-hidden="true"><path d="M4 16c30-8 62-11 96-8 28 2 56 2 96-6" /></svg></span>
        </h1>
        <p class="hero__lede">
          I'm a software engineer who loves turning hard, real-world problems into reliable software, from backend
          systems to machine learning and robotics.
        </p>
        <p class="hero__meta">
          <span>CS + Data Science at UW–Madison</span>
          <span>Graduating December 2026</span>
          <span>{contact.location}</span>
        </p>
        <p class="chip"><span class="chip__dot" aria-hidden="true"></span>Open to new-grad SWE &amp; ML roles</p>
        <div class="hero__actions">
          <a class="btn btn--ink" href={`mailto:${contact.email}`}><Icon name="mail" />Email me</a>
          <a class="btn" href={contact.github} target="_blank" rel="noopener"><Icon name="github" />GitHub</a>
          <a class="btn" href={contact.linkedin} target="_blank" rel="noopener"><Icon name="linkedin" />LinkedIn</a>
        </div>
      </div>

      <aside class="now card" aria-labelledby="now-h">
        <h2 id="now-h" class="now__title">Right now</h2>
        <ul class="now__list">
          <li class="area-robotics">
            <a href="#robocup">
              <span class="dot" aria-hidden="true"></span>
              <span>
                <strong>Robot localization at the Prediction and Action Lab</strong>
                <span>C++/ROS2 particle-filter localization with field-line observations.</span>
              </span>
            </a>
          </li>
          <li class="area-data">
            <a href="#werling">
              <span class="dot" aria-hidden="true"></span>
              <span>
                <strong>Air-pollution research at Werling Lab</strong>
                <span>Multivariate regression and factor analysis on 16 years of epidemiological data.</span>
              </span>
            </a>
          </li>
          <li class="area-backend">
            <a href="#fulfillmentiq">
              <span class="dot" aria-hidden="true"></span>
              <span>
                <strong>Just wrapped: FulfillmentIQ</strong>
                <span>FastAPI, Next.js, and SQLAlchemy/PostgreSQL, summer 2026.</span>
              </span>
            </a>
          </li>
        </ul>
      </aside>
    </section>

    <!-- Areas -->
    <section class="section wrap" id="work" aria-labelledby="work-h">
      <h2 class="section__title" id="work-h">What I work on</h2>
      <div class="areas">
        {
          areas.map((a) => (
            <article class:list={['area', `area-${a.id}`]}>
              <h3>{a.name}</h3>
              <p>{a.blurb}</p>
              <p class="area__where">
                <span class="area__label">Where:</span>
                {a.where.map((w) => (
                  <a href={`#${anchors[w]}`}>{w}</a>
                ))}
              </p>
            </article>
          ))
        }
      </div>
    </section>

    <!-- Experience -->
    <section class="section wrap" id="experience" aria-labelledby="exp-h">
      <h2 class="section__title" id="exp-h">Experience</h2>
      {
        groups.map((g) => (
          <div class="group">
            <h3 class="group__title" id={`${g.id}-h`}>
              {g.name}
            </h3>
            <ol class="roles" aria-labelledby={`${g.id}-h`}>
              {g.roles.map((r) => (
                <RoleEntry role={r} areaLabel={r.area && areaShort[r.area]} />
              ))}
            </ol>
          </div>
        ))
      }
      <div class="group">
        <h3 class="group__title" id="leadership-h">Leadership</h3>
        <ol class="roles" aria-labelledby="leadership-h">
          <RoleEntry role={leadership} />
        </ol>
      </div>
    </section>

    <!-- Projects -->
    <section class="section wrap" id="projects" aria-labelledby="proj-h">
      <h2 class="section__title" id="proj-h">Projects</h2>
      <div class="featured">
        {
          featured.map((p) => (
            <article class:list={['project', `area-${p.area}`]} id={p.id}>
              <h3>{p.title}</h3>
              <Story class="project__story" text={p.story} />
              {p.highlights && (
                <ul class="bullets">
                  {p.highlights.map((t) => (
                    <li>{t}</li>
                  ))}
                </ul>
              )}
              {p.details && (
                <details class="more">
                  <summary>How I built it</summary>
                  <ul class="bullets bullets--detail">
                    {p.details.map((d) => (
                      <li>{d}</li>
                    ))}
                  </ul>
                </details>
              )}
              <p class="builtwith">
                <span>Built with</span> {p.stack.join(', ')}
              </p>
              {p.links && (
                <p class="project__links">
                  {p.links.map((l, i) => (
                    <a class:list={['btn', 'btn--sm', { 'btn--ink': i === 0 }]} href={l.href} target="_blank" rel="noopener">
                      {l.label}
                      <Icon name="arrow" size={14} />
                    </a>
                  ))}
                </p>
              )}
            </article>
          ))
        }
      </div>

      <h3 class="group__title" id="earlier-h">Earlier projects</h3>
      <ul class="earlier" aria-labelledby="earlier-h">
        {
          earlier.map((p) => (
            <li class:list={['earlier__item', `area-${p.area}`]} id={p.id}>
              <span class="dot" aria-hidden="true" />
              <div>
                <h4>{p.title}</h4>
                <p>{p.story}</p>
                <p class="builtwith">
                  <span>Built with</span> {p.stack.join(', ')}
                </p>
              </div>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- About + education -->
    <section class="section wrap" id="about" aria-labelledby="about-h">
      <h2 class="section__title" id="about-h">A bit about me</h2>
      <div class="about">
        <div class="about__text">
          <p>
            I study Computer Science and Data Science at the University of Wisconsin–Madison. Across research and
            industry work, I've built everything from backend services to machine learning pipelines and robotics
            software.
          </p>
          <p>
            I like starting from the real problem, understanding the system end to end, and checking that a fix
            actually works. I enjoy working on teams that ship, and I'm always looking to learn new tools and domains.
          </p>
          <p>
            Outside class I was Head of Logistics for WiscoRaas, UW–Madison's Raas and Garba team, where I led a team
            of 20 running cultural events, fundraisers, and blood drives.
          </p>
        </div>
        <article class="card edu" aria-labelledby="edu-h">
          <h3 id="edu-h">{education.school}</h3>
          <p class="edu__degree">{education.degree}</p>
          <p class="muted">{education.dates} · GPA {education.gpa}</p>
          <dl class="facts">
            <div>
              <dt>Coursework</dt>
              <dd>{education.coursework.join(', ')}</dd>
            </div>
            <div>
              <dt>Honors</dt>
              <dd>{education.honors.join(' · ')}</dd>
            </div>
          </dl>
        </article>
      </div>
    </section>

    <!-- Skills -->
    <section class="section wrap" id="skills" aria-labelledby="skills-h">
      <h2 class="section__title" id="skills-h">Toolbox</h2>
      <dl class="skills">
        {
          skills.map((g) => (
            <div class="skills__row">
              <dt>{g.group}</dt>
              <dd>{g.items.join(', ')}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <!-- Contact -->
    <section class="section wrap" id="contact" aria-labelledby="contact-h">
      <div class="contact">
        <div>
          <h2 id="contact-h">Let's chat.</h2>
          <p>
            I'm looking for new-grad software engineering and machine learning roles starting after December 2026.
            If something here sounds like your team, I'd love to hear from you.
          </p>
          <div class="contact__actions">
            <a class="btn btn--ink" href={`mailto:${contact.email}`}><Icon name="mail" />{contact.email}</a>
            <button class="btn" type="button" data-copy={contact.email}>
              <Icon name="copy" /><span data-copy-label aria-live="polite">Copy email</span>
            </button>
          </div>
        </div>
        <dl class="contact__list">
          <div>
            <dt>Phone</dt>
            <dd><a href={contact.phoneHref}>{contact.phone}</a></dd>
          </div>
          <div>
            <dt>LinkedIn</dt>
            <dd><a href={contact.linkedin} target="_blank" rel="noopener">{contact.linkedinLabel}</a></dd>
          </div>
          <div>
            <dt>GitHub</dt>
            <dd><a href={contact.github} target="_blank" rel="noopener">{contact.githubLabel}</a></dd>
          </div>
          <div>
            <dt>Website</dt>
            <dd><a href={contact.website} target="_blank" rel="noopener">{contact.websiteLabel}</a></dd>
          </div>
        </dl>
      </div>
    </section>
  </main>

  <footer class="footer wrap">
    <span>© {year} Het Parekh · Madison, WI</span>
    <a href="#top" class="link-quiet">Back to top</a>
  </footer>

  <script>
    // Theme toggle: flips between light and dark and remembers the choice.
    const root = document.documentElement;
    const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
    const isDark = () =>
      root.dataset.theme ? root.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
    const sync = () => toggle?.setAttribute('aria-pressed', String(isDark()));
    sync();
    matchMedia('(prefers-color-scheme: dark)').addEventListener('change', sync);
    toggle?.addEventListener('click', () => {
      root.dataset.theme = isDark() ? 'light' : 'dark';
      sync();
      try {
        localStorage.setItem('theme', root.dataset.theme);
      } catch {}
    });

    // Print every "How I built it" fold open, then restore.
    let folded: HTMLDetailsElement[] = [];
    addEventListener('beforeprint', () => {
      folded = [...document.querySelectorAll<HTMLDetailsElement>('details.more:not([open])')];
      folded.forEach((d) => (d.open = true));
    });
    addEventListener('afterprint', () => folded.forEach((d) => (d.open = false)));

    // Copy email
    document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
      const label = btn.querySelector<HTMLElement>('[data-copy-label]')!;
      btn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(btn.dataset.copy!);
          label.textContent = 'Copied!';
        } catch {
          label.textContent = 'Press Ctrl+C to copy';
        }
        setTimeout(() => (label.textContent = 'Copy email'), 2000);
      });
    });

    // Close the mobile menu after choosing a section
    const menu = document.getElementById('menu') as (HTMLElement & { hidePopover?: () => void }) | null;
    document.querySelectorAll('[data-close-menu]').forEach((a) => a.addEventListener('click', () => menu?.hidePopover?.()));

    // Highlight the section in view
    const links = new Map(
      [...document.querySelectorAll<HTMLAnchorElement>('.topnav a')].map((a) => [a.hash.slice(1), a]),
    );
    const spy = new IntersectionObserver(
      (entries) =>
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          links.forEach((a) => a.removeAttribute('aria-current'));
          links.get(e.target.id)?.setAttribute('aria-current', 'true');
        }),
      { rootMargin: '-40% 0px -55% 0px' },
    );
    links.forEach((_, id) => {
      const el = document.getElementById(id);
      if (el) spy.observe(el);
    });
  </script>
</Base>
